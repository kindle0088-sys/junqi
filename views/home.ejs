<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <title>行军旗 - 在线对战</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
  <meta name="description" content="在线双人对战的军棋（行军旗）游戏">
  <link href="/css/styles.css" rel="stylesheet">
</head>
<body>
  <div class="junqi-header">
    <h1>🎲 行军旗</h1>
    <p>经典军棋在线对战 · 双人实时对弈 · 邀请好友一起玩</p>
  </div>

  <div class="home-container">
    <div class="home-card">
      <h3>🎮 创建新房间</h3>
      <form id="startForm" action="/start" method="POST">
        <div class="form-group">
          <label>选择阵营</label>
          <div class="btn-group" data-toggle="buttons">
            <label class="btn active">
              <input type="radio" name="player-color" value="blue" checked hidden> 蓝方
            </label>
            <label class="btn">
              <input type="radio" name="player-color" value="red" hidden> 红方
            </label>
          </div>
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%">创建房间</button>
      </form>
    </div>

    <div class="home-card ai-card">
      <h3>🤖 和电脑对战</h3>
      <p style="color:var(--text-muted);font-size:.82rem;margin-bottom:12px;">单人练习模式 · 智能 AI 对手</p>
      <form id="aiForm" action="/ai-start" method="POST">
        <div class="form-group">
          <label>选择你的阵营</label>
          <div class="btn-group" data-toggle="buttons">
            <label class="btn active">
              <input type="radio" name="player-color" value="blue" checked hidden> 蓝方（先手）
            </label>
            <label class="btn">
              <input type="radio" name="player-color" value="red" hidden> 红方
            </label>
          </div>
        </div>
        <button type="submit" class="btn btn-ai" style="width:100%">🤖 开始单人练习</button>
      </form>
    </div>

    <div class="home-card">
      <h3>🔗 加入已有房间</h3>
      <form id="joinForm" action="/join" method="POST">
        <div class="form-group">
          <label>选择要加入的游戏</label>
          <select class="form-control" name="game-id">
            <% for (var i = 0; i < listIDs.length; i++) { %>
            <option value='<%= listIDs[i] %>'><%= listIDs[i] %></option>
            <% } %>
          </select>
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%">加入游戏</button>
      </form>
    </div>

    <div style="text-align:center;color:var(--text-muted);font-size:.82rem;margin-top:12px;">
      基于开源项目 <a href="https://github.com/samuelyuan/online-junqi" target="_blank">online-junqi</a> 改进
    </div>
  </div>

  <script src="/js/jquery.min.js"></script>
  <script>
    // Toggle active class on color buttons
    $('.btn-group .btn').on('click', function() {
      $(this).siblings().removeClass('active');
      $(this).addClass('active');
    });
  </script>
</body>
</html>
